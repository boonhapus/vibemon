# Copy to repo-root `.env` and fill in every value.
# All keys use the VIBEMON_ prefix with __ for nested groups (see app/settings.py).
# Missing required variables cause Settings.load() to fail at startup.

# ── Runtime environment ──────────────────────────────────────────────────────
VIBEMON_ENVIRONMENT=dev

# ── Secrets (required) ────────────────────────────────────────────────────────
VIBEMON_SECRETS__ELEVEN_LABS=your-eleven-labs-key
VIBEMON_SECRETS__GOOGLE=your-google-ai-key
VIBEMON_SECRETS__LASTFM_KEY=your-lastfm-api-key
VIBEMON_SECRETS__LASTFM_SECRET=your-lastfm-api-secret
VIBEMON_SECRETS__TRAINER_ENCRYPTION=generate-a-long-random-string

# ── GenAI models (required) ─────────────────────────────────────────────────
VIBEMON_GENAI__TEXT=google-gla:gemini-2.0-flash
VIBEMON_GENAI__IMAGE=google-gla:gemini-2.0-flash

# ── Storage (required) ────────────────────────────────────────────────────────
VIBEMON_STORAGE__DATABASE=sqlite+aiosqlite:///C:/projects/vibemon/.generated/database/vibemon.sqlite
VIBEMON_STORAGE__CACHE=sqlite:///C:/projects/vibemon/.generated/database/api_cache.db
VIBEMON_STORAGE__ASSETS=file:///C:/projects/vibemon/.generated/monstore

# Postgres example (after `cd deploy/postgres && docker compose up -d`):
# VIBEMON_STORAGE__DATABASE=postgresql+asyncpg://vibemon:vibemon@127.0.0.1:5432/vibemon

# Redis provider cache example (after `cd deploy/redis && docker compose up -d`):
# Use the same password as REDIS_PASSWORD in deploy/redis/.env
# VIBEMON_STORAGE__CACHE=redis://:change-me-to-a-long-random-string@127.0.0.1:6379/0
# Shared Mac host (Tailscale / LAN):
# VIBEMON_STORAGE__CACHE=redis://:change-me-to-a-long-random-string@100.x.x.x:6379/0

# ── Last.fm OAuth callback (optional — defaults in code) ─────────────────────
# VIBEMON_LASTFM__CALLBACK=http://127.0.0.1:8765/lastfm/callback

# ── MusicBrainz Web API (optional — defaults to public API) ─────────────────
# Self-hosted mirror on Mac shared host (see docs/development/plans/infrastructure-plan.md):
# VIBEMON_MUSICBRAINZ__BASE_URL=http://192.168.x.x:5000/ws/2/

# ── Tests only ────────────────────────────────────────────────────────────────
# VIBEMON_TEST_DATABASE_URL=postgresql+asyncpg://vibemon:vibemon@127.0.0.1:5432/vibemon_test
